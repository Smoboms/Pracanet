import React from "react";
import { Link, useLocation, useNavigate } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { Home, PlusSquare, User, Menu, X, LogOut, Settings } from "lucide-react";
import { base44 } from "@/api/base44Client";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import { Button } from "@/components/ui/button";
import { Sheet, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from "@/components/ui/sheet";

export default function Layout({ children, currentPageName }) {
  const location = useLocation();
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const [synced, setSynced] = React.useState(false);
  const [isHeaderVisible, setIsHeaderVisible] = React.useState(true);
  const [isAuthenticated, setIsAuthenticated] = React.useState(null);
  const [menuOpen, setMenuOpen] = React.useState(false);

  React.useEffect(() => {
    const checkAuth = async () => {
      const authenticated = await base44.auth.isAuthenticated();
      setIsAuthenticated(authenticated);
      
      if (!authenticated && currentPageName !== 'Onboarding') {
        base44.auth.redirectToLogin(createPageUrl("Onboarding"));
      }
    };
    
    checkAuth();
  }, [currentPageName]);

  const { data: currentUser, isLoading: userLoading } = useQuery({
    queryKey: ['currentUser'],
    queryFn: () => base44.auth.me(),
    enabled: isAuthenticated === true,
    retry: false,
    staleTime: 30 * 60 * 1000,
    cacheTime: 60 * 60 * 1000,
  });

  React.useEffect(() => {
    const syncUserProfile = async () => {
      if (!currentUser || synced || !currentUser.onboarding_completed) return;
      
      const existingProfiles = await base44.entities.UserProfile.filter({ user_id: currentUser.id });
      
      if (existingProfiles.length === 0) {
        await base44.entities.UserProfile.create({
          user_id: currentUser.id,
          display_name: currentUser.display_name || 'Usuário',
          username: currentUser.username || '',
          bio: currentUser.bio || '',
          location: currentUser.location || '',
          location_link: currentUser.location_link || '',
          phone: currentUser.phone || '',
          external_link: currentUser.external_link || '',
          profile_image: currentUser.profile_image || '',
          cover_image: currentUser.cover_image || '',
          is_verified: currentUser.is_verified || false
        });
        queryClient.invalidateQueries(['userProfile', currentUser.id]);
      }
      setSynced(true);
    };
    
    syncUserProfile();
  }, [currentUser, synced, queryClient]);

  React.useEffect(() => {
    if (!userLoading && currentUser && currentPageName !== 'Onboarding') {
      const needsOnboarding = !currentUser.display_name || !currentUser.onboarding_completed;
      
      if (needsOnboarding) {
        navigate(createPageUrl("Onboarding"), { replace: true });
      }
    }
  }, [currentUser, userLoading, currentPageName, navigate]);

  React.useEffect(() => {
    const handleScroll = () => {
      setIsHeaderVisible(window.scrollY < 10);
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  const navItems = React.useMemo(() => {
    if (!currentUser?.id) return [];
    
    return [
      { name: "Início", path: createPageUrl("Home"), icon: Home },
      { name: "Publicar", path: createPageUrl("NewPost"), icon: PlusSquare },
      { name: "Perfil", path: createPageUrl("Profile") + `?userId=${currentUser.id}`, icon: User },
    ];
  }, [currentUser?.id]);

  const isActive = (path) => {
    if (path.includes('?')) {
      return location.pathname === path.split('?')[0];
    }
    return location.pathname === path;
  };

  const handleNavClick = (path) => {
    setMenuOpen(false);
    navigate(path);
  };

  const handleLogout = () => {
    setMenuOpen(false);
    base44.auth.logout();
  };

  const isAdmin = currentUser?.role === 'admin';

  if (currentPageName === 'Onboarding') {
    return children;
  }

  if (isAuthenticated === null) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-purple-50 to-blue-50">
        <div className="text-center">
          <div className="w-12 h-12 border-4 border-purple-600 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
          <p className="text-purple-600 font-semibold">Carregando...</p>
        </div>
      </div>
    );
  }

  if (isAuthenticated === false) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-purple-50 to-blue-50">
        <div className="text-center">
          <div className="w-12 h-12 border-4 border-purple-600 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
          <p className="text-purple-600 font-semibold">Redirecionando...</p>
        </div>
      </div>
    );
  }

  if (userLoading || !currentUser) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-purple-50 to-blue-50">
        <div className="text-center">
          <div className="w-12 h-12 border-4 border-purple-600 border-t-transparent rounded-full animate-spin mx-auto mb-4"></div>
          <p className="text-purple-600 font-semibold">Carregando perfil...</p>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-slate-50 via-purple-50/30 to-blue-50/30">
      <style>{`
        :root {
          --primary: #7C3AED;
          --primary-dark: #6D28D9;
          --secondary: #3B82F6;
        }
        
        .gradient-text {
          background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
        }
        
        .glass-effect {
          background: rgba(255, 255, 255, 0.9);
          backdrop-filter: blur(20px);
          border: 1px solid rgba(255, 255, 255, 0.5);
        }
        
        .icon-gradient {
          background: linear-gradient(135deg, #7C3AED 0%, #3B82F6 100%);
          -webkit-background-clip: text;
          -webkit-text-fill-color: transparent;
          background-clip: text;
        }

        .header-slide-up {
          transform: translateY(0);
          transition: transform 0.3s ease-in-out;
        }

        .header-slide-up.hidden {
          transform: translateY(-100%);
        }
      `}</style>

      <header className={`sticky top-0 z-40 glass-effect border-b border-purple-100 shadow-sm header-slide-up ${!isHeaderVisible ? 'hidden' : ''}`}>
        <div className="max-w-6xl mx-auto px-3 py-1.5">
          <div className="flex items-center justify-between">
            <h1 
              className="text-lg font-bold bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent cursor-pointer"
              onClick={() => navigate(createPageUrl("Home"))}
            >
              Praçanet
            </h1>
            
            <Sheet open={menuOpen} onOpenChange={setMenuOpen}>
              <SheetTrigger asChild>
                <Button 
                  variant="ghost" 
                  size="icon" 
                  className="rounded-full hover:bg-purple-50 w-12 h-12 transition-all hover:scale-110 active:scale-95"
                >
                  <Menu className="w-6 h-6 text-gray-700" />
                </Button>
              </SheetTrigger>
              <SheetContent side="right" className="w-80">
                <SheetHeader className="mb-6">
                  <SheetTitle className="gradient-text text-xl">Menu</SheetTitle>
                </SheetHeader>
                <nav className="space-y-2">
                  {navItems.map((item) => (
                    <button
                      key={item.name}
                      onClick={() => handleNavClick(item.path)}
                      className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all ${
                        isActive(item.path)
                          ? "bg-gradient-to-r from-purple-600 to-blue-600 text-white shadow-lg"
                          : "text-gray-700 hover:bg-purple-50 hover:translate-x-1"
                      }`}
                    >
                      <item.icon className="w-5 h-5" />
                      <span>{item.name}</span>
                    </button>
                  ))}
                  
                  {isAdmin && (
                    <>
                      <div className="pt-2 border-t border-gray-200 mt-2">
                        <p className="text-xs font-semibold text-gray-500 uppercase px-4 mb-2">Administração</p>
                        <button
                          onClick={() => handleNavClick(createPageUrl("AdminBanners"))}
                          className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl font-medium transition-all ${
                            isActive(createPageUrl("AdminBanners"))
                              ? "bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-lg"
                              : "text-amber-700 hover:bg-amber-50 hover:translate-x-1"
                          }`}
                        >
                          <Settings className="w-5 h-5" />
                          <span>Gerenciar Banners</span>
                        </button>
                      </div>
                    </>
                  )}
                  
                  <div className="pt-4 border-t border-gray-200 mt-4">
                    <button
                      onClick={handleLogout}
                      className="w-full flex items-center gap-3 px-4 py-3 rounded-xl font-medium text-red-600 hover:bg-red-50 transition-all hover:translate-x-1"
                    >
                      <LogOut className="w-5 h-5" />
                      <span>Sair da conta</span>
                    </button>
                  </div>
                </nav>
              </SheetContent>
            </Sheet>
          </div>
        </div>
      </header>

      <main className="pb-16">
        {children}
      </main>

      <nav className="fixed bottom-0 left-0 right-0 glass-effect border-t border-purple-100 shadow-2xl z-50">
        <div className="max-w-6xl mx-auto flex items-center justify-around px-4 py-2">
          {navItems.map((item) => (
            <Link
              key={item.name}
              to={item.path}
              className="p-1 transition-all"
            >
              <item.icon 
                className={`w-7 h-7 transition-all ${
                  isActive(item.path)
                    ? "icon-gradient scale-110"
                    : "text-gray-500"
                }`}
              />
            </Link>
          ))}
        </div>
      </nav>
    </div>
  );
}
