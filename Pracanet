export default function Search() {
  const [query, setQuery] = useState("");
  const [debouncedQuery, setDebouncedQuery] = useState("");
  const navigate = useNavigate();

  const { data: currentUser } = useQuery({
    queryKey: ['currentUser'],
    queryFn: () => base44.auth.me(),
    staleTime: 10 * 60 * 1000,
  });

  const { data: allUserProfiles = [], isLoading: profilesLoading } = useQuery({
    queryKey: ['publicUserProfiles'],
    queryFn: () => base44.entities.UserProfile.list('-created_date', 200),
    staleTime: 5 * 60 * 1000,
  });

  const { data: allPosts = [], isLoading: postsLoading } = useQuery({
    queryKey: ['allPosts'],
    queryFn: () => base44.entities.Post.list('-created_date', 200),
    staleTime: 2 * 60 * 1000,
  });

  React.useEffect(() => {
    const handler = setTimeout(() => {
      setDebouncedQuery(query);
    }, 300);

    return () => {
      clearTimeout(handler);
    };
  }, [query]);

  const filteredUsers = useMemo(() => {
    if (!debouncedQuery.trim()) return [];
    const q = debouncedQuery.toLowerCase();
    return allUserProfiles
      .filter(profile => 
        profile.display_name?.toLowerCase().includes(q) ||
        profile.username?.toLowerCase().includes(q) ||
        profile.bio?.toLowerCase().includes(q) ||
        profile.location?.toLowerCase().includes(q)
      )
      .slice(0, 20);
  }, [allUserProfiles, debouncedQuery]);

  const filteredPosts = useMemo(() => {
    if (!debouncedQuery.trim()) return [];
    const q = debouncedQuery.toLowerCase();
    return allPosts
      .filter(post => 
        post.content?.toLowerCase().includes(q)
      )
      .slice(0, 20);
  }, [allPosts, debouncedQuery]);

  const isLoading = profilesLoading || postsLoading;

  return (
    <div className="min-h-screen">
      <div className="max-w-2xl mx-auto px-4 py-6">
        <div className="mb-6">
          <h1 className="text-3xl font-bold mb-2 bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">
            Buscar
          </h1>
          <p className="text-gray-600">Encontre pessoas e publicações</p>
        </div>

        <div className="relative mb-6">
          <SearchIcon className="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" />
          <Input
            type="search"
            placeholder="Buscar no Praçanet..."
            value={query}
            onChange={(e) => setQuery(e.target.value)}
            className="pl-12 h-12 rounded-xl border-gray-200 focus:border-purple-300"
          />
          {isLoading && debouncedQuery && (
            <Loader2 className="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-purple-600 animate-spin" />
          )}
        </div>

        {!debouncedQuery ? (
          <div>
            <div className="flex items-center gap-2 mb-4">
              <TrendingUp className="w-5 h-5 text-purple-600" />
              <h2 className="text-lg font-bold text-gray-900">Categorias em Alta</h2>
            </div>
            <div className="grid grid-cols-2 gap-3">
              {TRENDING_CATEGORIES.map((cat) => (
                <button
                  key={cat.value}
                  onClick={() => navigate(createPageUrl("Home"))}
                  className="p-4 bg-white border border-gray-200 rounded-xl hover:border-purple-300 hover:shadow-md transition-all text-left"
                >
                  <Badge className={`${cat.color} mb-2`}>
                    {cat.label}
                  </Badge>
                  <p className="text-xs text-gray-500">Ver publicações</p>
                </button>
              ))}
            </div>
          </div>
        ) : (
          <Tabs defaultValue="all" className="w-full">
            <TabsList className="w-full mb-4">
              <TabsTrigger value="all" className="flex-1">
                Todos ({filteredUsers.length + filteredPosts.length})
              </TabsTrigger>
              <TabsTrigger value="people" className="flex-1">
                Pessoas ({filteredUsers.length})
              </TabsTrigger>
              <TabsTrigger value="posts" className="flex-1">
                Posts ({filteredPosts.length})
              </TabsTrigger>
            </TabsList>

            <TabsContent value="all" className="space-y-6">
              {filteredUsers.length > 0 && (
                <div>
                  <h3 className="font-bold text-gray-900 mb-3">Pessoas</h3>
                  <div className="space-y-2">
                    {filteredUsers.slice(0, 5).map((profile) => (
                      <UserCard key={profile.user_id} profile={profile} navigate={navigate} />
                    ))}
                  </div>
                </div>
              )}

              {filteredPosts.length > 0 && (
                <div>
                  <h3 className="font-bold text-gray-900 mb-3">Publicações</h3>
                  <div className="space-y-2">
                    {filteredPosts.slice(0, 5).map((post) => (
                      <PostCard key={post.id} post={post} navigate={navigate} />
                    ))}
                  </div>
                </div>
              )}

              {filteredUsers.length === 0 && filteredPosts.length === 0 && (
                <div className="text-center py-12">
                  <p className="text-gray-500">Nenhum resultado encontrado</p>
                </div>
              )}
            </TabsContent>

            <TabsContent value="people" className="space-y-2">
              {filteredUsers.map((profile) => (
                <UserCard key={profile.user_id} profile={profile} navigate={navigate} />
              ))}
              {filteredUsers.length === 0 && (
                <div className="text-center py-12">
                  <p className="text-gray-500">Nenhuma pessoa encontrada</p>
                </div>
              )}
            </TabsContent>

            <TabsContent value="posts" className="space-y-2">
              {filteredPosts.map((post) => (
                <PostCard key={post.id} post={post} navigate={navigate} />
              ))}
              {filteredPosts.length === 0 && (
                <div className="text-center py-12">
                  <p className="text-gray-500">Nenhuma publicação encontrada</p>
                </div>
              )}
            </TabsContent>
          </Tabs>
        )}
      </div>
    </div>
  );
}

