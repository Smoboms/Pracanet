import React, { useState, useEffect } from "react";
import { Sheet, SheetContent, SheetHeader, SheetTitle } from "@/components/ui/sheet";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Send, Loader2 } from "lucide-react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { base44 } from "@/api/base44Client";
import { useNavigate } from "react-router-dom";
import { createPageUrl } from "@/utils";
import moment from "moment";
import "moment/locale/pt-br";

moment.locale("pt-br");

const COMMENTS_PER_PAGE = 20;

export default function CommentsSheet({ post, isOpen, onClose, currentUser }) {
  const [newComment, setNewComment] = useState("");
  const [page, setPage] = useState(1);
  const queryClient = useQueryClient();
  const navigate = useNavigate();

  // Reset page quando o sheet abre
  useEffect(() => {
    if (isOpen) {
      setPage(1);
    }
  }, [isOpen]);

  const { data: allComments = [], isLoading: commentsLoading } = useQuery({
    queryKey: ['comments', post?.id, page],
    queryFn: async () => {
      const limit = COMMENTS_PER_PAGE * page;
      return await base44.entities.Comment.filter({ post_id: post.id }, '-created_date', limit);
    },
    enabled: !!post && isOpen,
    staleTime: 10 * 1000,
  });

  const { data: commentAuthorsMap = {} } = useQuery({
    queryKey: ['commentAuthors', allComments.map(c => c.user_id).join(',')],
    queryFn: async () => {
      if (!allComments.length) return {};
      
      const userIds = [...new Set(allComments.map(c => c.user_id))];
      const authorsMap = {};
      
      const allProfiles = await base44.entities.UserProfile.list('-created_date', 1000);
      const profilesById = {};
      allProfiles.forEach(profile => {
        profilesById[profile.user_id] = profile;
      });
      
      userIds.forEach((userId) => {
        if (currentUser && userId === currentUser.id) {
          authorsMap[userId] = {
            user_id: currentUser.id,
            display_name: currentUser.display_name,
            profile_image: currentUser.profile_image,
            username: currentUser.username,
          };
        } else if (profilesById[userId]) {
          authorsMap[userId] = profilesById[userId];
        } else {
          authorsMap[userId] = {
            user_id: userId,
            display_name: 'Membro Praçanet',
            profile_image: '',
            username: '',
          };
        }
      });
      
      return authorsMap;
    },
    enabled: allComments.length > 0,
    staleTime: 5 * 60 * 1000,
  });

  const createCommentMutation = useMutation({
    mutationFn: async (commentData) => {
      // Criar o comentário
      const comment = await base44.entities.Comment.create(commentData);
      
      // Buscar o post atualizado para obter a contagem correta
      const posts = await base44.entities.Post.filter({ id: post.id });
      const currentPost = posts[0];
      const currentCount = currentPost?.comments_count || 0;
      
      // Atualizar a contagem de comentários
      await base44.entities.Post.update(post.id, {
        comments_count: currentCount + 1
      });
      
      return { comment, newCount: currentCount + 1 };
    },
    onSuccess: (data) => {
      // Invalidar todas as queries relacionadas
      queryClient.invalidateQueries(['comments', post.id]);
      queryClient.invalidateQueries(['posts']);
      queryClient.invalidateQueries(['userPosts']);
      
      // Limpar o campo de input
      setNewComment("");
      
      // Resetar a página para mostrar o novo comentário
      setPage(1);
    },
    onError: (error) => {
      console.error('Erro ao criar comentário:', error);
      alert('Erro ao adicionar comentário. Tente novamente.');
    },
  });

  const handleSubmit = (e) => {
    e.preventDefault();
    if (!newComment.trim()) return;
    if (!currentUser) {
      alert("Faça login para comentar");
      return;
    }

    createCommentMutation.mutate({
      post_id: post.id,
      user_id: currentUser.id,
      content: newComment.trim(),
    });
  };

  const handleLoadMore = () => {
    setPage(prev => prev + 1);
  };

  const getTimeAgo = (dateString) => {
    const commentDate = moment(dateString).utcOffset(-3, true);
    return commentDate.fromNow();
  };

  const hasMore = allComments.length >= (COMMENTS_PER_PAGE * page);

  if (!post) return null;

  return (
    <Sheet open={isOpen} onOpenChange={onClose}>
      <SheetContent side="bottom" className="h-[85vh] flex flex-col p-0">
        <SheetHeader className="p-4 border-b">
          <SheetTitle>Comentários ({post.comments_count || 0})</SheetTitle>
        </SheetHeader>

        <div className="flex-1 overflow-y-auto p-4 space-y-4">
          {commentsLoading && page === 1 ? (
            <div className="text-center py-8">
              <Loader2 className="w-6 h-6 animate-spin text-purple-600 mx-auto" />
            </div>
          ) : allComments.length === 0 ? (
            <div className="text-center py-12">
              <p className="text-gray-500">Seja o primeiro a comentar!</p>
            </div>
          ) : (
            <>
              {allComments.map((comment) => {
                const author = commentAuthorsMap[comment.user_id] || {};
                const displayName = author.display_name || 'Usuário';
                
                return (
                  <div 
                    key={comment.id} 
                    className="flex gap-3 cursor-pointer hover:bg-gray-50 p-2 rounded-lg transition-colors"
                    onClick={() => {
                      onClose();
                      navigate(createPageUrl("Profile") + `?userId=${comment.user_id}`);
                    }}
                  >
                    <Avatar className="w-10 h-10 ring-2 ring-purple-100 flex-shrink-0">
                      <AvatarImage src={author.profile_image} className="object-cover" />
                      <AvatarFallback className="bg-gradient-to-br from-purple-500 to-blue-500 text-white font-semibold">
                        {displayName.charAt(0).toUpperCase()}
                      </AvatarFallback>
                    </Avatar>
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2 mb-1">
                        <p className="font-semibold text-sm text-gray-900 truncate">{displayName}</p>
                        <span className="text-xs text-gray-500">
                          {getTimeAgo(comment.created_date)}
                        </span>
                      </div>
                      <p className="text-gray-700 text-sm break-words">{comment.content}</p>
                    </div>
                  </div>
                );
              })}
              {hasMore && (
                <div className="text-center pt-2">
                  <Button
                    variant="outline"
                    onClick={handleLoadMore}
                    disabled={commentsLoading}
                    className="rounded-xl"
                  >
                    {commentsLoading && page > 1 ? (
                      <>
                        <Loader2 className="w-4 h-4 mr-2 animate-spin" />
                        Carregando...
                      </>
                    ) : (
                      'Carregar mais'
                    )}
                  </Button>
                </div>
              )}
            </>
          )}
        </div>

        <form onSubmit={handleSubmit} className="p-4 border-t bg-white">
          <div className="flex gap-2">
            <Avatar className="w-10 h-10 ring-2 ring-purple-100 flex-shrink-0">
              <AvatarImage src={currentUser?.profile_image} className="object-cover" />
              <AvatarFallback className="bg-gradient-to-br from-purple-500 to-blue-500 text-white font-semibold">
                {currentUser?.display_name?.charAt(0).toUpperCase() || 'U'}
              </AvatarFallback>
            </Avatar>
            <Input
              value={newComment}
              onChange={(e) => setNewComment(e.target.value)}
              placeholder="Adicione um comentário..."
              className="flex-1 rounded-xl"
              disabled={createCommentMutation.isPending}
            />
            <Button 
              type="submit" 
              size="icon"
              disabled={!newComment.trim() || createCommentMutation.isPending}
              className="rounded-xl bg-gradient-to-r from-purple-600 to-blue-600"
            >
              {createCommentMutation.isPending ? (
                <Loader2 className="w-5 h-5 animate-spin" />
              ) : (
                <Send className="w-5 h-5" />
              )}
            </Button>
          </div>
        </form>
      </SheetContent>
    </Sheet>
  );
}
