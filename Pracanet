import React, { useState } from "react";
import { base44 } from "@/api/base44Client";
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query";
import { useNavigate } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { Label } from "@/components/ui/label";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Camera, Loader2, Sparkles } from "lucide-react";
import BenchLogo from "../components/BenchLogo";

export default function Onboarding() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const [uploading, setUploading] = useState(false);
  const [error, setError] = useState("");

  const { data: currentUser } = useQuery({
    queryKey: ['currentUser'],
    queryFn: () => base44.auth.me(),
  });

  const [formData, setFormData] = useState({
    display_name: '',
    profile_image: '',
  });

  const completeOnboardingMutation = useMutation({
    mutationFn: async (data) => {
      const profileData = {
        display_name: data.display_name,
        profile_image: data.profile_image,
        onboarding_completed: true,
        username: '',
        bio: '',
        location: '',
        location_link: '',
        phone: '',
        external_link: '',
        cover_image: '',
        is_verified: false
      };
      
      await base44.auth.updateMe(profileData);
      
      const existing = await base44.entities.UserProfile.filter({ user_id: currentUser.id });
      if (existing && existing.length > 0) {
        await base44.entities.UserProfile.update(existing[0].id, {
          display_name: data.display_name,
          profile_image: data.profile_image
        });
      } else {
        await base44.entities.UserProfile.create({
          user_id: currentUser.id,
          display_name: data.display_name,
          profile_image: data.profile_image,
          username: '',
          bio: '',
          location: '',
          location_link: '',
          phone: '',
          external_link: '',
          cover_image: '',
          is_verified: false
        });
      }
    },
    onSuccess: async () => {
      await queryClient.invalidateQueries(['currentUser']);
      navigate(createPageUrl("Home"));
    },
    onError: (err) => {
      setError(`Erro ao salvar: ${err.message || 'Tente novamente'}`);
    },
  });

  const handleImageUpload = async (e) => {
    const file = e.target.files[0];
    if (!file) return;

    setUploading(true);
    setError("");

    try {
      const { file_url } = await base44.integrations.Core.UploadFile({ file });
      setFormData({ ...formData, profile_image: file_url });
    } catch (err) {
      setError("Erro ao fazer upload");
    } finally {
      setUploading(false);
    }
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    
    if (!formData.display_name.trim()) {
      setError("Digite seu nome");
      return;
    }
    if (!formData.profile_image) {
      setError("Adicione uma foto");
      return;
    }

    completeOnboardingMutation.mutate(formData);
  };

  React.useEffect(() => {
    if (currentUser?.onboarding_completed) {
      navigate(createPageUrl("Home"));
    }
  }, [currentUser, navigate]);

  if (!currentUser) {
    return (
      <div className="min-h-screen flex items-center justify-center">
        <Loader2 className="w-8 h-8 animate-spin text-purple-600" />
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-gradient-to-br from-purple-50 via-blue-50 to-purple-50 flex items-center justify-center p-4">
      <div className="max-w-md w-full">
        <div className="text-center mb-8">
          <div className="flex justify-center mb-4">
            <BenchLogo className="w-20 h-20 text-purple-600" />
          </div>
          <h1 className="text-3xl font-bold mb-2">
            <span className="bg-gradient-to-r from-purple-600 to-blue-600 bg-clip-text text-transparent">
              Bem-vindo ao Praçanet!
            </span>
          </h1>
          <p className="text-gray-600">Complete seu perfil</p>
          <p className="text-xs text-gray-500 mt-2">Email: {currentUser.email}</p>
        </div>

        {error && (
          <Alert variant="destructive" className="mb-4">
            <AlertDescription>{error}</AlertDescription>
          </Alert>
        )}

        <form onSubmit={handleSubmit} className="bg-white rounded-2xl shadow-xl p-6 space-y-6">
          <div className="flex flex-col items-center">
            <Label className="mb-3 text-center font-semibold">Sua foto *</Label>
            <div className="relative">
              <Avatar className="w-32 h-32 ring-4 ring-purple-100">
                <AvatarImage src={formData.profile_image} className="object-cover" />
                <AvatarFallback className="bg-gradient-to-br from-purple-500 to-blue-500 text-white text-4xl font-bold">
                  {formData.display_name?.charAt(0).toUpperCase() || '?'}
                </AvatarFallback>
              </Avatar>

              <label className="absolute inset-0 flex items-center justify-center bg-black/40 hover:bg-black/50 rounded-full transition-colors cursor-pointer">
                <input
                  type="file"
                  accept="image/*"
                  onChange={handleImageUpload}
                  className="hidden"
                  disabled={uploading}
                />
                {uploading ? (
                  <div className="text-center">
                    <Loader2 className="w-8 h-8 text-white animate-spin mx-auto" />
                    <p className="text-xs text-white mt-1">Processando...</p>
                  </div>
                ) : (
                  <Camera className="w-8 h-8 text-white" />
                )}
              </label>
            </div>
            <p className="text-xs text-gray-500 mt-2">Clique para adicionar (400x400)</p>
          </div>

          <div className="space-y-2">
            <Label htmlFor="display_name" className="font-semibold">Seu nome *</Label>
            <Input
              id="display_name"
              value={formData.display_name}
              onChange={(e) => setFormData({ ...formData, display_name: e.target.value })}
              placeholder="Como quer ser chamado?"
              className="rounded-xl h-12 text-base"
              autoFocus
              required
            />
          </div>

          <Button
            type="submit"
            className="w-full bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 rounded-xl h-12 text-base font-semibold"
            disabled={completeOnboardingMutation.isPending || uploading}
          >
            {completeOnboardingMutation.isPending ? (
              <>
                <Loader2 className="w-5 h-5 mr-2 animate-spin" />
                Salvando...
              </>
            ) : (
              <>
                <Sparkles className="w-5 h-5 mr-2" />
                Começar agora!
              </>
            )}
          </Button>
        </form>
      </div>
    </div>
  );
}

import React, { useState, useMemo, useRef, useEffect } from "react";
import { base44 } from "@/api/base44Client";
import { useQuery } from "@tanstack/react-query";
import { Tabs, TabsList, TabsTrigger } from "@/components/ui/tabs";
import { Skeleton } from "@/components/ui/skeleton";
import PostCard from "../components/feed/PostCard";
import CommentsSheet from "../components/feed/CommentsSheet";
import { Sparkles } from "lucide-react";

const CATEGORIES = [
  { value: "all", label: "🌟 Todos" },
  { value: "general", label: "💬 Geral" },
  { value: "car_motos", label: "🚘 Car/Motos" },
  { value: "rent", label: "🏠 Aluguel" },
  { value: "real_estate", label: "🏡 Venda" },
  { value: "jobs", label: "💼 Vagas" },
  { value: "services", label: "🛠 Serviços" },
  { value: "marketplace", label: "🛍 Compra/Venda" },
  { value: "desapega", label: "♻️ Desapega" },
  { value: "gambira", label: "🔄 Gambira" },
  { value: "flea_market", label: "🧺 Feira de Usados" },
  { value: "carpool", label: "🚗 Carona" },
  { value: "news", label: "📰 Notícias" },
];

export default function Home() {
  const [selectedCategory, setSelectedCategory] = useState("all");
  const [selectedPost, setSelectedPost] = useState(null);
  const [bannerIndex, setBannerIndex] = useState(0);
  const [touchStart, setTouchStart] = useState(0);
  const [touchEnd, setTouchEnd] = useState(0);
  const [isPaused, setIsPaused] = useState(false);
  const autoPlayRef = useRef(null);

  const { data: currentUser } = useQuery({
    queryKey: ['currentUser'],
    queryFn: () => base44.auth.me(),
    staleTime: 30 * 60 * 1000,
    cacheTime: 60 * 60 * 1000,
  });

  const { data: posts = [], isLoading: postsLoading } = useQuery({
    queryKey: ['posts', selectedCategory],
    queryFn: async () => {
      if (selectedCategory === "all") {
        return await base44.entities.Post.list('-created_date', 100);
      } else {
        return await base44.entities.Post.filter({ category: selectedCategory }, '-created_date', 100);
      }
    },
    enabled: !!currentUser,
    staleTime: 5 * 60 * 1000,
    cacheTime: 10 * 60 * 1000,
  });

  const { data: userProfilesMap = {} } = useQuery({
    queryKey: ['feedUserProfiles', posts.map(p => p.user_id).join(',')],
    queryFn: async () => {
      if (!posts.length) return {};
      
      const userIds = [...new Set(posts.map(p => p.user_id))];
      const profilesMap = {};
      
      const allProfiles = await base44.entities.UserProfile.list('-created_date', 500);
      const profilesById = {};
      allProfiles.forEach(profile => {
        profilesById[profile.user_id] = profile;
      });
      
      userIds.forEach((userId) => {
        if (currentUser && userId === currentUser.id) {
          profilesMap[userId] = {
            user_id: currentUser.id,
            display_name: currentUser.display_name,
            username: currentUser.username,
            profile_image: currentUser.profile_image,
            location: currentUser.location,
            bio: currentUser.bio,
            is_verified: currentUser.is_verified || false
          };
        } else if (profilesById[userId]) {
          profilesMap[userId] = profilesById[userId];
        } else {
          profilesMap[userId] = {
            user_id: userId,
            display_name: 'Membro Praçanet',
            profile_image: '',
            username: '',
            location: '',
            bio: '',
            is_verified: false
          };
        }
      });
      
      return profilesMap;
    },
    enabled: posts.length > 0 && !!currentUser,
    staleTime: 10 * 60 * 1000,
    cacheTime: 20 * 60 * 1000,
  });

  const { data: banners = [] } = useQuery({
    queryKey: ['banners'],
    queryFn: async () => {
      const result = await base44.entities.Banner.filter({ is_active: true }, 'order');
      return result.filter(banner => banner.image_url && banner.image_url.trim() !== '');
    },
    enabled: !!currentUser,
    staleTime: 30 * 60 * 1000,
    cacheTime: 60 * 60 * 1000,
  });

  const featuredPosts = useMemo(() => posts.filter(p => p.is_featured), [posts]);
  const regularPosts = useMemo(() => posts.filter(p => !p.is_featured), [posts]);

  useEffect(() => {
    if (banners.length > 1 && !isPaused) {
      autoPlayRef.current = setInterval(() => {
        setBannerIndex((prev) => (prev + 1) % banners.length);
      }, 4000);
      
      return () => {
        if (autoPlayRef.current) {
          clearInterval(autoPlayRef.current);
        }
      };
    }
  }, [banners.length, isPaused]);

  const handleTouchStart = (e) => {
    setIsPaused(true);
    setTouchStart(e.touches[0].clientX);
  };

  const handleTouchMove = (e) => {
    setTouchEnd(e.touches[0].clientX);
  };

  const handleTouchEnd = () => {
    if (!touchStart || !touchEnd) return;
    
    const distance = touchStart - touchEnd;
    const minSwipeDistance = 50;
    
    if (distance > minSwipeDistance) {
      setBannerIndex((prev) => (prev + 1) % banners.length);
    }
    
    if (distance < -minSwipeDistance) {
      setBannerIndex((prev) => (prev - 1 + banners.length) % banners.length);
    }
    
    setTouchStart(0);
    setTouchEnd(0);
    
    setTimeout(() => setIsPaused(false), 2000);
  };

  return (
    <div className="min-h-screen">
      <style>{`
        .banner-carousel {
          width: 100%;
          overflow: hidden;
          position: relative;
          margin: 0;
          padding: 0;
          touch-action: pan-x;
          border-radius: 0;
        }

        .banner-carousel .slides {
          display: flex;
          width: ${banners.length * 100}%;
          transform: translateX(-${bannerIndex * (100 / banners.length)}%);
          transition: transform 0.5s ease-out;
        }

        .banner-carousel .slide {
          width: ${100 / (banners.length || 1)}%;
          flex-shrink: 0;
          position: relative;
        }

        .banner-carousel .slide::before {
          content: '';
          position: absolute;
          inset: 0;
          background: linear-gradient(to bottom, 
            transparent 0%,
            transparent 40%,
            rgba(0, 0, 0, 0.3) 70%,
            rgba(0, 0, 0, 0.7) 100%);
          z-index: 1;
          pointer-events: none;
        }

        .banner-carousel img {
          width: 100%;
          height: 200px;
          object-fit: cover;
          display: block;
          filter: brightness(1.1) contrast(1.15) saturate(1.3);
        }

        @media (min-width: 640px) {
          .banner-carousel img {
            height: 220px;
          }
        }

        .indicators {
          position: absolute;
          bottom: 8px;
          left: 50%;
          transform: translateX(-50%);
          display: flex;
          gap: 8px;
          z-index: 10;
        }

        .dot {
          width: 8px;
          height: 8px;
          background: rgba(255, 255, 255, 0.6);
          border-radius: 50%;
          transition: all 0.3s ease;
          cursor: pointer;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .dot.active {
          background: linear-gradient(135deg, #ec4899, #8b5cf6);
          width: 24px;
          border-radius: 4px;
          box-shadow: 0 2px 12px rgba(236, 72, 153, 0.6);
        }

        .banner-overlay {
          position: absolute;
          bottom: 18px;
          left: 0;
          right: 0;
          padding: 0 0.75rem;
          color: white;
          z-index: 2;
        }

        @media (min-width: 640px) {
          .banner-overlay {
            bottom: 20px;
            padding: 0 1rem;
          }
        }

        .banner-overlay h2 {
          text-shadow: 0 4px 20px rgba(0, 0, 0, 1);
          font-weight: 700;
          margin-bottom: 0.125rem;
          line-height: 1.1;
        }

        .banner-overlay p {
          text-shadow: 0 3px 15px rgba(0, 0, 0, 0.95);
          line-height: 1.2;
          margin: 0;
        }

        .categories-scroll {
          overflow-x: auto;
          scrollbar-width: none;
          -ms-overflow-style: none;
          scroll-behavior: smooth;
        }

        .categories-scroll::-webkit-scrollbar {
          display: none;
        }

        .categories-scroll .tabs-list {
          display: inline-flex;
          flex-wrap: nowrap;
          width: auto;
          min-width: 100%;
        }

        @media (max-width: 768px) {
          .feed-container {
            padding-left: 0 !important;
            padding-right: 0 !important;
          }
          
          .feed-spacing {
            padding-left: 0 !important;
            padding-right: 0 !important;
          }
          
          .verse-container {
            padding-left: 0 !important;
            padding-right: 0 !important;
          }
          
          .categories-container {
            padding-left: 0 !important;
            padding-right: 0 !important;
          }
        }
      `}</style>

      {banners.length > 0 && (
        <div 
          className="banner-carousel"
          onTouchStart={handleTouchStart}
          onTouchMove={handleTouchMove}
          onTouchEnd={handleTouchEnd}
        >
          <div className="slides">
            {banners.map((banner) => (
              <div key={banner.id} className="slide">
                <div className="relative">
                  <img 
                    src={banner.image_url} 
                    alt={banner.title}
                    loading="lazy"
                  />
                  <div className="banner-overlay">
                    <h2 className="text-base sm:text-lg font-bold">{banner.title}</h2>
                    {banner.description && (
                      <p className="text-xs sm:text-sm text-gray-100">{banner.description}</p>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
          
          {banners.length > 1 && (
            <div className="indicators">
              {banners.map((_, index) => (
                <div
                  key={index}
                  className={`dot ${index === bannerIndex ? 'active' : ''}`}
                  onClick={() => {
                    setBannerIndex(index);
                    setIsPaused(true);
                    setTimeout(() => setIsPaused(false), 2000);
                  }}
                />
              ))}
            </div>
          )}
        </div>
      )}

      <div className="verse-container max-w-2xl mx-auto md:px-4 py-1">
        <div className="bg-white border border-gray-100 md:rounded-lg shadow-sm">
          <div className="px-2 py-1">
            <p className="text-center text-[10px] sm:text-[11px] leading-tight text-gray-600">
              <span className="inline">"Lançai sobre Ele toda a vossa ansiedade."</span>{' '}
              <span className="text-purple-600 font-semibold whitespace-nowrap">(1 Pedro 5:7)</span>
            </p>
          </div>
        </div>
      </div>

      <div className="categories-container max-w-2xl mx-auto md:px-4 py-1">
        <div className="bg-white md:rounded-xl shadow-sm border border-gray-100">
          <div className="categories-scroll px-1 py-1">
            <Tabs value={selectedCategory} onValueChange={setSelectedCategory}>
              <TabsList className="tabs-list gap-1 bg-transparent">
                {CATEGORIES.map((category) => (
                  <TabsTrigger
                    key={category.value}
                    value={category.value}
                    className="rounded-lg text-xs px-2 py-1 whitespace-nowrap data-[state=active]:bg-gradient-to-r data-[state=active]:from-purple-600 data-[state=active]:to-blue-600 data-[state=active]:text-white"
                  >
                    {category.label}
                  </TabsTrigger>
                ))}
              </TabsList>
            </Tabs>
          </div>
        </div>
      </div>

      <div className="feed-container max-w-2xl mx-auto md:px-4 pt-2">
        {postsLoading && (
          <div className="space-y-2 px-4 md:px-0">
            {[1, 2].map((i) => (
              <div key={i} className="bg-white rounded-2xl p-4 space-y-3">
                <div className="flex items-center gap-3">
                  <Skeleton className="w-12 h-12 rounded-full" />
                  <div className="flex-1">
                    <Skeleton className="h-4 w-32 mb-2" />
                    <Skeleton className="h-3 w-24" />
                  </div>
                </div>
                <Skeleton className="h-20 w-full" />
              </div>
            ))}
          </div>
        )}

        {!postsLoading && featuredPosts.length > 0 && (
          <div className="feed-spacing px-4 md:px-0 space-y-2">
            <div className="flex items-center gap-2 text-amber-600">
              <Sparkles className="w-5 h-5" />
              <h3 className="font-bold text-lg">Publicações em Destaque</h3>
            </div>
            {featuredPosts.map((post) => (
              <PostCard
                key={post.id}
                post={post}
                currentUser={currentUser}
                userProfile={userProfilesMap[post.user_id]}
                onCommentClick={setSelectedPost}
              />
            ))}
          </div>
        )}

        {!postsLoading && regularPosts.length === 0 && featuredPosts.length === 0 && (
          <div className="text-center py-12 px-4">
            <div className="w-20 h-20 mx-auto mb-4 bg-gradient-to-br from-purple-100 to-blue-100 rounded-full flex items-center justify-center">
              <Sparkles className="w-10 h-10 text-purple-600" />
            </div>
            <h3 className="text-xl font-bold text-gray-900 mb-2">
              Nenhuma publicação ainda
            </h3>
            <p className="text-gray-600">
              Seja o primeiro a compartilhar algo com a comunidade!
            </p>
          </div>
        )}

        {!postsLoading && regularPosts.length > 0 && (
          <div className="feed-spacing">
            {regularPosts.map((post) => (
              <PostCard
                key={post.id}
                post={post}
                currentUser={currentUser}
                userProfile={userProfilesMap[post.user_id]}
                onCommentClick={setSelectedPost}
              />
            ))}
          </div>
        )}
      </div>

      <CommentsSheet
        post={selectedPost}
        isOpen={!!selectedPost}
        onClose={() => setSelectedPost(null)}
        currentUser={currentUser}
      />
    </div>
  );
}
import React, { useState } from "react";
import { base44 } from "@/api/base44Client";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { useNavigate } from "react-router-dom";
import { createPageUrl } from "@/utils";
import { Avatar, AvatarFallback, AvatarImage } from "@/components/ui/avatar";
import { Button } from "@/components/ui/button";
import { Skeleton } from "@/components/ui/skeleton";
import { MapPin, ExternalLink as LinkIcon, Settings, Share2, UserPlus, UserMinus, MessageCircle, Grid3x3 } from "lucide-react";
import { Tabs, TabsList, TabsTrigger, TabsContent } from "@/components/ui/tabs";
import FollowersSheet from "../components/profile/FollowersSheet";
import FollowingSheet from "../components/profile/FollowingSheet";
import PostModal from "../components/profile/PostModal";

export default function Profile() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const urlParams = new URLSearchParams(window.location.search);
  const profileUserId = urlParams.get("userId");
  const [showFollowers, setShowFollowers] = useState(false);
  const [showFollowing, setShowFollowing] = useState(false);
  const [selectedPost, setSelectedPost] = useState(null);

  const { data: currentUser } = useQuery({
    queryKey: ['currentUser'],
    queryFn: () => base44.auth.me(),
    retry: false,
    staleTime: 5 * 60 * 1000,
  });

  const { data: profileUser, isLoading: profileLoading } = useQuery({
    queryKey: ['userProfile', profileUserId],
    queryFn: async () => {
      if (currentUser && profileUserId === currentUser.id) {
        return {
          user_id: currentUser.id,
          display_name: currentUser.display_name,
          username: currentUser.username,
          bio: currentUser.bio,
          location: currentUser.location,
          location_link: currentUser.location_link,
          phone: currentUser.phone,
          external_link: currentUser.external_link,
          profile_image: currentUser.profile_image,
          cover_image: currentUser.cover_image,
          is_verified: currentUser.is_verified || false
        };
      }
      
      const profiles = await base44.entities.UserProfile.filter({ user_id: profileUserId });
      
      if (profiles && profiles.length > 0) {
        return profiles[0];
      }
      
      const userPosts = await base44.entities.Post.filter({ user_id: profileUserId }, '-created_date', 1);
      
      if (userPosts && userPosts.length > 0) {
        return {
          user_id: profileUserId,
          display_name: 'Membro Praçanet',
          username: '',
          bio: '',
          location: '',
          location_link: '',
          phone: '',
          external_link: '',
          profile_image: '',
          cover_image: '',
          is_verified: false,
          _isTemporary: true
        };
      }
      
      return null;
    },
    enabled: !!profileUserId && !!currentUser,
    staleTime: 2 * 60 * 1000,
  });

  const { data: userPosts = [], isLoading: postsLoading } = useQuery({
    queryKey: ['userPosts', profileUserId],
    queryFn: () => base44.entities.Post.filter({ user_id: profileUserId }, '-created_date', 100),
    enabled: !!profileUserId,
    staleTime: 2 * 60 * 1000,
  });

  const { data: followData } = useQuery({
    queryKey: ['follow', currentUser?.id, profileUserId],
    queryFn: () => base44.entities.Follow.filter({ follower_id: currentUser.id, following_id: profileUserId }),
    enabled: !!currentUser && !!profileUserId && currentUser.id !== profileUserId,
    staleTime: 30 * 1000,
  });

  const { data: followersCount = 0 } = useQuery({
    queryKey: ['followersCount', profileUserId],
    queryFn: async () => {
      const followers = await base44.entities.Follow.filter({ following_id: profileUserId });
      return followers.length;
    },
    enabled: !!profileUserId,
    staleTime: 60 * 1000,
  });

  const { data: followingCount = 0 } = useQuery({
    queryKey: ['followingCount', profileUserId],
    queryFn: async () => {
      const following = await base44.entities.Follow.filter({ follower_id: profileUserId });
      return following.length;
    },
    enabled: !!profileUserId,
    staleTime: 60 * 1000,
  });

  const isFollowing = followData && followData.length > 0;
  const isOwnProfile = currentUser?.id === profileUserId;
  const displayName = profileUser?.display_name || 'Usuário';

  const followMutation = useMutation({
    mutationFn: async () => {
      if (isFollowing) {
        await base44.entities.Follow.delete(followData[0].id);
        return 'unfollow';
      } else {
        await base44.entities.Follow.create({
          follower_id: currentUser.id,
          following_id: profileUserId,
        });
        return 'follow';
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries(['follow']);
      queryClient.invalidateQueries(['followersCount']);
      queryClient.invalidateQueries(['followingCount']);
    },
  });

  const handleShare = async () => {
    const url = `${window.location.origin}${createPageUrl("Profile")}?userId=${profileUserId}`;
    const shareData = {
      title: `${displayName}`,
      text: `Confira o perfil de ${displayName}!`,
      url: url,
    };

    try {
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        await navigator.clipboard.writeText(url);
        alert("Link copiado!");
      }
    } catch (error) {
      if (error.name !== 'AbortError') {
        await navigator.clipboard.writeText(url);
        alert("Link copiado!");
      }
    }
  };

  const getWhatsAppLink = (phone) => {
    if (!phone) return null;
    const cleaned = phone.replace(/\D/g, '');
    return `https://wa.me/55${cleaned}`;
  };

  const postsWithImages = userPosts.filter(post => post.images && post.images.length > 0);

  if (profileLoading || !currentUser) {
    return (
      <div className="max-w-2xl mx-auto px-4 py-6">
        <Skeleton className="w-full h-48 rounded-2xl mb-4" />
        <Skeleton className="w-32 h-32 rounded-full mx-auto -mt-20 mb-4" />
        <Skeleton className="h-8 w-48 mx-auto mb-2" />
        <Skeleton className="h-4 w-32 mx-auto" />
      </div>
    );
  }

  if (!profileUser) {
    return (
      <div className="max-w-2xl mx-auto px-4 py-12 text-center">
        <h2 className="text-2xl font-bold text-gray-900 mb-2">Perfil não encontrado</h2>
        <p className="text-gray-600 mb-2">Este usuário ainda não completou o cadastro.</p>
        <p className="text-sm text-gray-500 mb-4">ID buscado: {profileUserId}</p>
        <Button onClick={() => navigate(createPageUrl("Home"))}>
          Voltar para o Feed
        </Button>
      </div>
    );
  }

  return (
    <div className="min-h-screen pb-8">
      <div className="max-w-2xl mx-auto">
        {profileUser._isTemporary && (
          <div className="px-4 py-2 bg-yellow-50 border border-yellow-200 rounded-lg mb-4 text-center">
            <p className="text-sm text-yellow-800">
              ⚠️ Este é um perfil temporário. O usuário precisa fazer login novamente para atualizar seu perfil.
            </p>
          </div>
        )}

        <div className="relative">
          <div
            className="h-48 w-full rounded-b-3xl bg-gradient-to-br from-purple-600 via-blue-600 to-purple-600"
            style={
              profileUser.cover_image
                ? { backgroundImage: `url(${profileUser.cover_image})`, backgroundSize: 'cover', backgroundPosition: 'center' }
                : {}
            }
          />

          <div className="px-4">
            <Avatar className="w-32 h-32 border-4 border-white shadow-xl -mt-16 mx-auto ring-4 ring-purple-100">
              <AvatarImage src={profileUser.profile_image} className="object-cover" />
              <AvatarFallback className="bg-gradient-to-br from-purple-500 to-blue-500 text-white text-4xl font-bold">
                {displayName.charAt(0).toUpperCase()}
              </AvatarFallback>
            </Avatar>
          </div>
        </div>

        <div className="px-4 mt-4 text-center">
          <div className="flex items-center justify-center gap-2 mb-1">
            <h1 className="text-2xl font-bold text-gray-900">{displayName}</h1>
          </div>

          {profileUser.username && (
            <p className="text-gray-500 mb-3">@{profileUser.username}</p>
          )}

          {profileUser.bio && (
            <p className="text-gray-700 mb-4 max-w-md mx-auto">{profileUser.bio}</p>
          )}

          <div className="flex items-center justify-center gap-6 mb-4">
            <div>
              <p className="text-2xl font-bold text-gray-900">{userPosts.length}</p>
              <p className="text-sm text-gray-500">Publicações</p>
            </div>
            <button
              onClick={() => setShowFollowers(true)}
              className="hover:opacity-70 transition-opacity focus:outline-none"
            >
              <p className="text-2xl font-bold text-gray-900">{followersCount}</p>
              <p className="text-sm text-gray-500">Seguidores</p>
            </button>
            <button
              onClick={() => setShowFollowing(true)}
              className="hover:opacity-70 transition-opacity focus:outline-none"
            >
              <p className="text-2xl font-bold text-gray-900">{followingCount}</p>
              <p className="text-sm text-gray-500">Seguindo</p>
            </button>
          </div>

          <div className="flex flex-wrap items-center justify-center gap-3 mb-4">
            {profileUser.location && (
              <a
                href={profileUser.location_link || `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(profileUser.location)}`}
                target="_blank"
                rel="noopener noreferrer"
                onClick={(e) => e.stopPropagation()}
                className="flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 rounded-xl hover:bg-gray-50 hover:border-purple-300 transition-all shadow-sm"
              >
                <MapPin className="w-4 h-4 text-purple-600" />
                <span className="text-sm font-medium text-gray-700">{profileUser.location}</span>
              </a>
