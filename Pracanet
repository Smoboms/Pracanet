export default function BannerCreator() {
  const [generating, setGenerating] = useState(false);
  const [progress, setProgress] = useState("");
  const queryClient = useQueryClient();

  const createBanners = async () => {
    setGenerating(true);
    
    const bannerPrompts = [
      {
        title: "Bem-vindo ao Praçanet! 🎉",
        description: "Conecte-se com sua comunidade",
        prompt: "Create a vibrant, modern banner (1200x400px) with a gradient background from purple (#7C3AED) to blue (#3B82F6). Feature a minimalist black bench icon in the center-left. Add elegant white text 'Bem-vindo ao Praçanet!' in bold, with subtitle 'Conecte-se com sua comunidade' below. Include small icons: heart, comment bubble, and user silhouettes on the right side. Professional, clean design with subtle geometric patterns in the background. High quality, Brazilian Portuguese text."
      },
      {
        title: "Descubra Vagas, Serviços e Mais! 💼",
        description: "Tudo que você precisa em um só lugar",
        prompt: "Create a dynamic, colorful banner (1200x400px) with a split gradient: purple (#7C3AED) on left transitioning to orange (#F97316) on right. Place a black bench icon prominently. Show floating emoji icons: 💼 (jobs), 🛠 (services), 🏠 (rent), 🛍 (shopping) arranged artistically. Bold white text 'Descubra Vagas, Serviços e Mais!' with subtitle 'Tudo que você precisa em um só lugar'. Modern, energetic design with depth and shadows. Brazilian Portuguese."
      },
      {
        title: "Compartilhe, Conecte, Cresça! 🌟",
        description: "Sua rede social local",
        prompt: "Create an inspiring, gradient banner (1200x400px) with vibrant colors: purple (#7C3AED) to pink (#EC4899) to blue (#3B82F6). Feature a stylized black bench icon with a glowing effect. Add circular profile avatars connected by lines (representing community). Bold white text 'Compartilhe, Conecte, Cresça!' with sparkle emoji ✨. Subtitle 'Sua rede social local'. Modern, social media style with depth, light effects and energy. Brazilian Portuguese."
      }
    ];

    try {
      for (let i = 0; i < bannerPrompts.length; i++) {
        const banner = bannerPrompts[i];
        setProgress(`Gerando banner ${i + 1} de 3: ${banner.title}`);
        
        const imageResult = await base44.integrations.Core.GenerateImage({
          prompt: banner.prompt
        });
        
        await base44.entities.Banner.create({
          title: banner.title,
          description: banner.description,
          image_url: imageResult.url,
          link_url: "",
          is_active: true,
          order: i
        });
        
        await new Promise(resolve => setTimeout(resolve, 2000));
      }
      
      setProgress("✅ Todos os banners foram criados!");
      queryClient.invalidateQueries(['banners']);
      
      setTimeout(() => {
        setGenerating(false);
        setProgress("");
      }, 2000);
      
    } catch (error) {
      setProgress("❌ Erro ao criar banners");
      setGenerating(false);
    }
  };

  return (
    <div className="p-6 bg-white rounded-xl shadow-lg max-w-md mx-auto">
      <h3 className="text-xl font-bold mb-4 text-gray-900">
        Criar Banners do Praçanet
      </h3>
      <p className="text-sm text-gray-600 mb-4">
        Clique para gerar 3 banners criativos e vibrantes para o app
      </p>
      
      {progress && (
        <div className="mb-4 p-3 bg-purple-50 rounded-lg">
          <p className="text-sm text-purple-800">{progress}</p>
        </div>
      )}
      
      <Button
        onClick={createBanners}
        disabled={generating}
        className="w-full bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700"
      >
        {generating ? (
          <>
            <Loader2 className="w-4 h-4 mr-2 animate-spin" />
            Gerando...
          </>
        ) : (
          "Gerar 3 Banners"
        )}
      </Button>
    </div>
  );
}
