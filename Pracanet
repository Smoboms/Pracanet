function PostCard({ post, currentUser, userProfile, onCommentClick }) {
  const [currentImageIndex, setCurrentImageIndex] = useState(0);
  const [isExpanded, setIsExpanded] = useState(false);
  const [touchStart, setTouchStart] = useState(0);
  const [touchEnd, setTouchEnd] = useState(0);
  const navigate = useNavigate();
  const queryClient = useQueryClient();

  // Sincronizar contadores com os dados do post
  const [likesCount, setLikesCount] = useState(post.likes_count || 0);
  const [commentsCount, setCommentsCount] = useState(post.comments_count || 0);

  useEffect(() => {
    setLikesCount(post.likes_count || 0);
    setCommentsCount(post.comments_count || 0);
  }, [post.likes_count, post.comments_count]);

  const { data: likeData, refetch: refetchLike } = useQuery({
    queryKey: ['like', currentUser?.id, post.id],
    queryFn: () => base44.entities.Like.filter({ user_id: currentUser.id, post_id: post.id }),
    enabled: !!currentUser,
    staleTime: 30 * 1000,
  });

  const isLiked = likeData && likeData.length > 0;

  const deletePostMutation = useMutation({
    mutationFn: () => base44.entities.Post.delete(post.id),
    onSuccess: () => {
      queryClient.invalidateQueries(['posts']);
      queryClient.invalidateQueries(['userPosts']);
    },
  });

  const toggleLikeMutation = useMutation({
    mutationFn: async () => {
      if (isLiked && likeData?.[0]) {
        // Remover like
        await base44.entities.Like.delete(likeData[0].id);
        const newCount = Math.max(0, (post.likes_count || 0) - 1);
        await base44.entities.Post.update(post.id, { likes_count: newCount });
        return { action: 'unlike', newCount };
      } else {
        // Adicionar like
        await base44.entities.Like.create({ user_id: currentUser.id, post_id: post.id });
        const newCount = (post.likes_count || 0) + 1;
        await base44.entities.Post.update(post.id, { likes_count: newCount });
        return { action: 'like', newCount };
      }
    },
    onSuccess: (data) => {
      // Atualizar contadores locais
      setLikesCount(data.newCount);
      
      // Invalidar queries para sincronizar com o servidor
      queryClient.invalidateQueries(['like', currentUser.id, post.id]);
      queryClient.invalidateQueries(['posts']);
      queryClient.invalidateQueries(['userPosts']);
    },
    onError: () => {
      // Em caso de erro, recarregar os dados
      refetchLike();
      queryClient.invalidateQueries(['posts']);
    },
  });

  const handleLike = (e) => {
    e.stopPropagation();
    if (!currentUser) {
      alert("Faça login para curtir");
      return;
    }
    toggleLikeMutation.mutate();
  };

  const handleEdit = (e) => {
    e.stopPropagation();
    navigate(createPageUrl("EditPost") + `?postId=${post.id}`);
  };

  const handleDelete = async (e) => {
    e.stopPropagation();
    if (window.confirm('Deseja excluir esta publicação?')) {
      deletePostMutation.mutate();
    }
  };

  const handleShare = async (e) => {
    e.stopPropagation();
    const url = `${window.location.origin}${createPageUrl("Home")}`;
    const shareData = {
      title: `${userProfile?.display_name || 'Usuário'} no Praçanet`,
      text: post.content.substring(0, 100),
      url: url,
    };

    try {
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        await navigator.clipboard.writeText(url);
        alert("Link copiado!");
      }
    } catch (error) {
      if (error.name !== 'AbortError') {
        await navigator.clipboard.writeText(url);
        alert("Link copiado!");
      }
    }
  };

  const handleTouchStart = (e) => {
    if (post.images && post.images.length > 1) {
      setTouchStart(e.touches[0].clientX);
    }
  };

  const handleTouchMove = (e) => {
    if (post.images && post.images.length > 1) {
      setTouchEnd(e.touches[0].clientX);
    }
  };

  const handleTouchEnd = () => {
    if (!touchStart || !touchEnd || !post.images || post.images.length <= 1) return;
    
    const distance = touchStart - touchEnd;
    const minSwipeDistance = 50;
    
    if (distance > minSwipeDistance) {
      setCurrentImageIndex((prev) => (prev + 1) % post.images.length);
    }
    
    if (distance < -minSwipeDistance) {
      setCurrentImageIndex((prev) => (prev - 1 + post.images.length) % post.images.length);
    }
    
    setTouchStart(0);
    setTouchEnd(0);
  };

  const getTimeAgo = (dateString) => {
    const postDate = moment(dateString).utcOffset(-3, true);
    return postDate.fromNow();
  };

  const displayName = userProfile?.display_name || 'Membro Praçanet';
  const categoryInfo = CATEGORY_LABELS[post.category] || { label: post.category, color: "bg-gray-100 text-gray-800" };
  const isOwner = currentUser?.id === post.user_id;
  const needsTruncation = post.content && post.content.length > 80;

  return (
    <Card className="bg-white border-0 shadow-sm hover:shadow-md transition-shadow md:rounded-2xl rounded-none mb-2">
      <CardContent className="p-0">
        <div className="p-4 pb-2">
          <div className="flex items-center justify-between mb-3">
